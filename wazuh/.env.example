# Copy this file to `.env` and set strong values. `.env` is GITIGNORED.
# These are the only secrets the Wazuh stack needs; keeping them here (not in
# docker-compose.yml) is why no credential is ever committed.

INDEXER_PASSWORD=CHANGE_ME_indexer_admin_password
API_PASSWORD=CHANGE_ME_api_password
DASHBOARD_PASSWORD=CHANGE_ME_dashboard_password
